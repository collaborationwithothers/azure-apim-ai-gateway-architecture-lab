<policies>
  <inbound>
    <base />
    <llm-token-limit counter-key="@(context.Subscription.Id)" tokens-per-minute="50000" estimate-prompt-tokens="true" remaining-tokens-variable-name="remainingTokens" />
    <set-backend-service backend-id="openai-backend-placeholder" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-header name="x-ai-gateway-remaining-tokens" exists-action="override">
      <value>@((string)context.Variables[&quot;remainingTokens&quot;])</value>
    </set-header>
  </outbound>
  <on-error><base /></on-error>
</policies>
